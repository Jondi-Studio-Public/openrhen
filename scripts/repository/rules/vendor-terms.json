{
  "_comment": "The vendor term sets of the vendor-isolation ratchet (rules/vendor-terms.mjs). This file is the one place core may list vendor names, as data, and is exempt from the rule itself. Every set only grows: scripts/test/vendor-terms.test.mjs pins the floor and the rule compares with the base commit. Regex fragments are matched case-insensitively unless a set says otherwise.",
  "terms": {
    "provider": [
      "google",
      "gmail",
      "openai",
      "deepinfra",
      "ollama",
      "youtube",
      "spotify",
      "discord",
      "takeout",
      "apple",
      "iphone",
      "steam",
      "garmin",
      "anthropic",
      "ukg",
      "kronos",
      "skylight",
      "apns"
    ],
    "wider": {
      "deviceMakers": [
        "apple",
        "garmin",
        "google",
        "fitbit",
        "whoop",
        "oura",
        "polar",
        "samsung",
        "huawei",
        "amazfit",
        "coros",
        "withings",
        "suunto",
        "xiaomi",
        "strava"
      ],
      "messaging": ["whatsapp", "telegram"],
      "modelFamilies": ["qwen[0-9.]*", "gemma", "gemini", "llama", "mistral", "gpt-[0-9][a-z0-9.-]*"],
      "products": ["microsoft", "firefox", "safari", "android", "ipad", "crios", "edg"],
      "network": ["tailscale", "tailnet", "icloud", "fastmail", "firebase", "fcm", "ts\\.net"],
      "cloud": ["aws", "alibaba"]
    },
    "capitalised": ["Outlook", "Chrome"],
    "owner": ["\\bjondi(?![-_]studio)", "jondipc", "jondihaynes"],
    "agents": {
      "substring": ["openclaw", "claude", "chatgpt"],
      "word": ["codex", "windsurf"]
    },
    "pathWords": ["chrome"]
  },
  "discovery": {
    "pass": "modularity A1, 2026-11-09: user-agent regexes, host names in non-test code, model-id shapes",
    "added": ["ts\\.net (the tailnet host suffix; agent-wake-sender.ts and tests)"],
    "considered": [
      {
        "candidate": "Windows, Mac OS X, Macintosh, Linux (user-agent operating systems)",
        "decision": "not added",
        "why": "Operating systems, not providers a deployment chooses; the owner-auth and notification detection code names them as the platform defines them."
      },
      {
        "candidate": "Mozilla (user-agent prefix, push host)",
        "decision": "not added",
        "why": "The generic user-agent prefix appears in tests; the Firefox push host is in the standard-endpoint row."
      },
      {
        "candidate": "bank, merchant and health-service host names in the spend and appointment category lists",
        "decision": "not added",
        "why": "A different domain from data sources, models, calendars, travel, media, mail, push and agent clients; for Jondi's call whether the V1 definition widens to them."
      },
      {
        "candidate": "healthchecks.io",
        "decision": "not added",
        "why": "A monitoring endpoint in docs; for Jondi's call."
      },
      {
        "candidate": "model-id shapes (name:8b tags, Org/Model-id)",
        "decision": "covered",
        "why": "Every id found names a model family already in the set (qwen); the shape itself matches ordinary identifiers such as time zones, so it is not a pattern."
      }
    ]
  },
  "defaults": [
    {
      "id": "port-11434",
      "pattern": "11434",
      "skipTests": true,
      "why": "Ollama's default port"
    },
    {
      "id": "embedding-size",
      "pattern": "1,?024|EMBEDDING_DIMENSIONS",
      "countBy": "line",
      "alsoOnLine": "dim|vector|embed",
      "skipTests": true,
      "skipExtensions": [".md"],
      "why": "A fixed embedding size fits one model only"
    }
  ],
  "schema": {
    "files": ["platform/database/src/schema/core.ts", "platform/contracts/src/secrets.ts"]
  },
  "lanes": [
    {
      "lane": "G",
      "globs": ["package.json"]
    },
    {
      "lane": "Y",
