{
  "name": "rhen",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm format:check && pnpm lint && pnpm structure:check && pnpm test-files:check && pnpm docs:check && pnpm test:scripts",
    "lint": "oxlint --deny-warnings engine integrations platform portal tools scripts",
    "docs:check": "node scripts/docs/check.mjs",
    "format": "prettier --write \"{engine,integrations,platform,portal,tools,scripts}/**/*.{ts,tsx,mjs}\"",
    "format:check": "prettier --check \"{engine,integrations,platform,portal,tools,scripts}/**/*.{ts,tsx,mjs}\"",
    "cli": "pnpm --filter @openrhen/cli start",
    "seams:generate": "node scripts/repository/seam-inventory.mjs --fix-pending --generate",
    "structure:check": "node scripts/repository/check-structure.mjs",
    "test-files:check": "node scripts/test/coverage.mjs",
    "dev": "pnpm --filter @openrhen/portal dev",
    "dev:all": "pnpm --parallel --filter @openrhen/engine-service --filter @openrhen/engine-worker --filter @openrhen/portal dev",
    "dev:portal": "pnpm --filter @openrhen/portal dev",
    "build:portal": "pnpm --filter @openrhen/portal build",
    "smoke:production": "node scripts/smoke/production-click.mjs",
    "smoke:closed": "node scripts/smoke/closed-flow.mjs",
    "smoke:source-cancel": "node scripts/smoke/source-cancel-flow.mjs",
    "smoke:recurrence-end": "node scripts/smoke/recurrence-end-flow.mjs",
    "dev:engine-service": "pnpm --filter @openrhen/engine-service dev",
    "dev:engine-worker": "pnpm --filter @openrhen/engine-worker dev",
    "dev:outbound-proxy": "pnpm --filter @openrhen/outbound-proxy dev",
    "test": "pnpm -r --if-present test && pnpm test:performance",
    "test:performance": "pnpm --filter @openrhen/engine-core test:performance",
    "test:changed": "node scripts/test/changed.mjs",
    "gate": "pnpm check && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build:portal && pnpm smoke:production",
    "test:scripts": "node --test \"scripts/addon/*.test.mjs\" \"scripts/backup/*.test.mjs\" \"scripts/deploy/*.test.mjs\" \"scripts/ops/*.test.mjs\" \"scripts/selfhost/*.test.mjs\" \"scripts/setup/*.test.mjs\" \"scripts/smoke/*.test.mjs\" \"scripts/test/*.test.mjs\"",
    "test:integration": "pnpm -r --if-present test:integration",
    "export:round-trip": "pnpm --filter @openrhen/portal export:round-trip",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:generate": "pnpm --filter @openrhen/database db:generate",
    "db:create": "pnpm --filter @openrhen/database db:create",
    "db:backup": "pnpm --filter @openrhen/database db:backup",
    "db:migrate": "pnpm --filter @openrhen/database db:migrate",
    "db:migrations:check": "pnpm --filter @openrhen/database db:migrations:check",
    "seed:demo": "pnpm --filter @openrhen/database seed:demo",
    "db:restore:verify": "pnpm --filter @openrhen/database db:restore:verify",
    "backup:run": "node scripts/backup/backup-and-copy.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "oxc-parser": "0.156.0",
    "oxlint": "1.92.0",
    "prettier": "3.9.10",
    "puppeteer-core": "25.16.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
