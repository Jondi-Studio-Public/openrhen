{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrhen.example/schemas/agent-sessions.v1.json",
  "title": "OpenRhen agent sessions, version 1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "sessions": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$",
            "description": "The client's own id for this session; posting it again replaces the record."
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "endedAt": {
            "type": "string",
            "format": "date-time"
          },
          "kind": {
            "default": "conversation",
            "type": "string",
            "enum": [
              "conversation",
              "work",
              "other"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "topics": {
            "default": [],
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "turns": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          }
        },
        "required": [
          "id",
          "startedAt",
          "endedAt"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "sessions"
  ]
}
