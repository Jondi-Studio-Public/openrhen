{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrhen.example/schemas/physiology.v1.json",
  "title": "OpenRhen physiology events, version 1",
  "description": "One event of source physiology, as an element of the events list of POST /api/activity-events (see activity-events.v1.json for the batch). Every physiology event is a period row identified by its canonical key, <kind>|<attrs.device>|<period>|v<attrs.v>; route is not part of it. This schema checks shape; the server also checks what it cannot express: the key, that start sits on the period boundary, values.length against step_s, n, min <= avg <= max, coverage_s, sorted non-overlapping segments and offsets, and flags against values. It states the fix for each rejection. Physiology rows are context for a predictor: nothing here changes what the plan allows.",
  "type": "object",
  "required": [
    "id",
    "source",
    "kind",
    "start",
    "attrs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "The canonical key. The server states the one it expected."
    },
    "source": {
      "const": "physiology"
    },
    "kind": {
      "enum": [
        "heart_rate",
        "heart_rate_dense",
        "hrv",
        "stress",
        "score_series",
        "respiration",
        "spo2",
        "skin_temp",
        "steps",
        "movement",
        "sleep",
        "daily",
        "score",
        "workout",
        "correction"
      ]
    },
    "start": {
      "type": "string",
      "format": "date-time"
    },
    "end": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "tzOffsetMin": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": -840,
      "maximum": 840
    },
    "approximate": {
      "type": "boolean",
      "description": "True for values inferred rather than measured; required for movement basis inferred."
    },
    "attrs": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "heart_rate"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "attrs": {
            "$ref": "#/$defs/attrs/heart_rate"
