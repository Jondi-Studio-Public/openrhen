# OpenRhen environment. Run `docker compose run --rm setup` (or
# `node scripts/setup/init-env.mjs`) to create .env from this file with fresh secrets; it never
# prints a value and never overwrites one you set. Keep real secrets in .env or your secrets
# manager, never in a file you commit.
#
# Three sections: 1. Quick start (Docker), 2. Optional core connections, 3. Hardening and monitoring.

# ---------------------------------------------------------------------------------------------
# 1. Quick start (Docker)
# ---------------------------------------------------------------------------------------------
# Which compose services run: the core app plus the bundled Postgres.
COMPOSE_PROFILES=app,bundled-db
# Generated by init-env. Also fills the __POSTGRES_PASSWORD__ token in the two URLs below.
POSTGRES_PASSWORD=
# Host port for the bundled Postgres when running from source (`init-env --mode source`).
POSTGRES_HOST_PORT=55432
# Use sslmode=require if PostgreSQL is configured for TLS.
DATABASE_URL=postgresql://openrhen:__POSTGRES_PASSWORD__@postgres:5432/openrhen?sslmode=disable
# Administrative connection used only to create isolated local databases.
POSTGRES_ADMIN_URL=postgresql://openrhen:__POSTGRES_PASSWORD__@postgres:5432/postgres?sslmode=disable
# 127.0.0.1 keeps the portal on this machine, and is the default if you leave this out. Set 0.0.0.0 (or a LAN
# address) to publish beyond it, and lock the portal down first (owner sign-in below).
PORTAL_HOST_IP=127.0.0.1
# Set to your IANA zone, for example Europe/London. (init-env fills this from the host when it can.)
APP_TIMEZONE=UTC
# Date and time format for the display: an English locale such as en-GB or en-US. Defaults to en.
# APP_LOCALE=en-GB
# Tokens between the services. init-env replaces each with 32 random bytes.
PLAN_FORECAST_SERVICE_TOKEN=replace-before-lan-use
OUTBOUND_PROXY_TOKEN=replace-before-lan-use
# Bearer token the phone presents to POST /api/location/ping, the one portal route that can move
# the "where I am now" assertion. Leaving this unset closes the endpoint entirely rather than opening it, so
# a portal reachable beyond this machine stays safe by default. Generate a long random
# value, put the same one in the phone's settings, and never reuse another token here.
LOCATION_PING_TOKEN=replace-before-lan-use
# Web Push keys (leave-by prompts). init-env generates the pair; see section 2.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
# off = no sign-in (fine on 127.0.0.1). Turn it on before exposing the portal beyond this machine.
OPENRHEN_OWNER_AUTH=off

# Other settings and developer notes.
TARGET_DATABASE_NAME=openrhen
PLANNING_HORIZON_END=22:00
# Integration test databases: leave TEST_DATABASE_NAME unset and every run mints its own
# `<name>_<suffix>_test` databases and drops them afterwards, so two runs can execute at once.
# Set it (must end in _test) to pin one fixed database that is reused across runs and never
# dropped — useful for inspecting state after a failure, unsafe for concurrent runs.
# TEST_DATABASE_NAME=openrhen_test
# Restore drills refuse to target a database without this suffix.
RESTORE_DATABASE_NAME=openrhen_restore_test
# Optional override; otherwise the most recent file under var/backups/ is used.
# BACKUP_FILE=C:/path/to/openrhen-backup.json
# Separate Plan and Forecast Engine. Generate a long random token before exposing it on your LAN.
PLAN_FORECAST_SERVICE_URL=http://127.0.0.1:4100
PLAN_FORECAST_HOST=0.0.0.0
PLAN_FORECAST_PORT=4100
PLAN_FORECAST_REQUEST_TIMEOUT_MS=10000
PLAN_FORECAST_MAX_PAYLOAD_BYTES=5242880
# Host folder for photo check-in blobs. Mounted into the portal; backup copies it.
# PHOTO_STORE_HOST_DIR=./var/photos
OUTBOUND_PROXY_URL=http://127.0.0.1:4200
OUTBOUND_PROXY_HOST=0.0.0.0
OUTBOUND_PROXY_PORT=4200
# Calls per minute the proxy allows across /ai/extract and /ai/stream before answering 429.
OUTBOUND_AI_RATE_LIMIT_PER_MINUTE=30

# ---------------------------------------------------------------------------------------------
# 2. Optional core connections: Google Calendar, an OpenAI-compatible model, Google Maps, Web Push
# ---------------------------------------------------------------------------------------------
# Calendar sync: read by the worker AND the portal, so a provider left out
# is neither scheduled nor runnable from "Sync now". Comma-separated; default google_calendar.
# CALENDAR_SYNC_PROVIDERS=google_calendar
# CALENDAR_SYNC_INTERVAL_MINUTES=60   # worker: minutes between syncs of each provider
# CALENDAR_SYNC_MAX_DELETES=10        # portal: deletes one run may apply before it holds them all for review
# AI brain dump import (portal/app/api/imports/extract). The model call also runs in the
# outbound-proxy service, for the same reason: the key stays out of the portal.
# OPENAI_API_KEY=your-openai-api-key
# Google Maps Platform key (Geocoding + Routes APIs) for location-aware planning; also outbound-proxy-only.
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Web Push (leave-by prompts, docs/operations/web-push.md). Generate with
# `node integrations/outbound-proxy/scripts/generate-vapid-keys.mjs`; outbound-proxy-only — the
# portal fetches the public key from the proxy and never holds the private one.
# WEB_PUSH_VAPID_PUBLIC_KEY=generated-public-key
# WEB_PUSH_VAPID_PRIVATE_KEY=generated-private-key
# WEB_PUSH_SUBJECT=mailto:you@example.com
# Google Calendar (integrations/outbound-proxy, read-only). Set only on
# the outbound proxy. The client can be a Desktop-type OAuth client. The refresh
# token is saved to an owner-only temp file (not printed) by `corepack pnpm --filter @openrhen/outbound-proxy google-calendar:auth`.
# GOOGLE_CALENDAR_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CALENDAR_CLIENT_SECRET=...
# GOOGLE_CALENDAR_REFRESH_TOKEN=...
# Calendar feed (outbound proxy only): a private https iCal address; the address is the secret.
# CALENDAR_FEED_URL=https://example.com/private/calendar.ics
# Proactive agent wake (engine worker): OpenClaw gateway base URL and its hooks.token. Both must be set.
# OPENCLAW_HOOKS_URL=http://127.0.0.1:18789
# OPENCLAW_HOOKS_TOKEN=...
# Optional routing so a wake lands in your main chat session instead of an isolated one (all five together):
# OPENCLAW_HOOKS_AGENT_ID=main
# OPENCLAW_HOOKS_CHANNEL=telegram
# OPENCLAW_HOOKS_ACCOUNT_ID=main
# OPENCLAW_HOOKS_TO=<chat id>
# OPENCLAW_HOOKS_SESSION_KEY=agent:main:main

# ---------------------------------------------------------------------------------------------
# 3. Hardening and monitoring
# ---------------------------------------------------------------------------------------------
# Public pulse tracker — outbound-proxy-only; the URL and secret never
# enter the database, a backup, or the portal process. PULSE_PUBLISH_URL must be https. A receiver verifies the
# signed Pulse-Signature header with the same secret (see the operations doc).
# PULSE_PUBLISH_URL=https://your-tracker.example.com/api/pulse
# PULSE_PUBLISH_SECRET=generate-a-long-random-secret
# Hosts the portal answers to (DNS-rebinding defence); portal:8787 is engine-worker and the CLI,
# 127.0.0.1:8787 the health check. Unset accepts only localhost, 127.0.0.1, [::1] (any port), portal:8787 and the
# host of PORTAL_PUBLIC_URL. Set PORTAL_PUBLIC_URL to the https address you serve it on, or list the hosts here.
# PORTAL_PUBLIC_URL=https://portal.example.com
# PORTAL_ALLOWED_HOSTS=portal.example.com,portal:8787,127.0.0.1:8787,localhost:8787

# --- Backup (self-hosting) ---
# Daily verified backup (the `backup` compose service). On by default; there is no switch. With nothing set below,
# backups stay in ./var/backups on this machine and the Data check says they do not leave it.
# BACKUP_HOST_DIR=./var/backups
# Where the verified copy goes: a host folder with .openrhen-backup-target at its root (a NAS share, another disk).
# BACKUP_COPY_DIR=
# Set to "off" to accept local-only backups on purpose; the Data check then stops mentioning it.
# BACKUP_COPY=off
# A healthchecks.io check URL that alerts when a backup is missed. Blank (or "off") means no monitor.
# BACKUP_PING_URL=
# Time of day (24-hour HH:mm, in BACKUP_TZ) and time zone for the daily run.
# BACKUP_TIME=03:30
# BACKUP_TZ=UTC
